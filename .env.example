# Nomes das variáveis de ambiente. NENHUM valor aqui é segredo; na nuvem os valores reais ficam nos
# "Secrets/Variables" da plataforma, nunca no repositório. Em desenvolvimento local nada é obrigatório.

# ---- Geral ----
PORT=3001
HOST=127.0.0.1                 # na nuvem: 0.0.0.0
ROLE=all                       # api | worker | all
NODE_ENV=development           # production na nuvem (exige APP_SECRET e login)
TRUST_PROXY=false              # true atrás de proxy (Railway, Fly, Cloudflare)
WEB_ORIGINS=http://localhost:3000   # origens do site autorizadas (vírgula); na nuvem: https://seu-dominio

# ---- Banco de dados ----
# Vazio = PGlite local em data/pglite. Na nuvem: URL do PostgreSQL.
DATABASE_URL=
DATABASE_SSL=false             # true se o provedor exigir SSL
DATABASE_PATH=data/pglite      # só para PGlite; ':memory:' = memória

# ---- Login ----
AUTH_MODE=off                  # em produção é sempre obrigatório (AUTH_MODE=off é recusado)
ADMIN_EMAIL=
ADMIN_PASSWORD=                # mínimo 12 caracteres; trocar aqui troca a senha e encerra as sessões
APP_SECRET=                    # 32+ caracteres aleatórios; assina os links de envio
SESSION_TTL_DAYS=30

# ---- Armazenamento de arquivos ----
STORAGE_DRIVER=local           # local | s3
STORAGE_PATH=storage           # driver local
S3_ENDPOINT=                   # ex.: https://<id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false      # true para MinIO
AUDIO_MAX_MB=1024
API_PUBLIC_URL=                # URL pública da API (links de envio do driver local)

# ---- Fila ----
JOB_POLL_MS=1000
JOB_CONCURRENCY=2
JOB_LEASE_SEC=60
JOB_BACKOFF_SEC=5

# ---- Site (apps/web) ----
API_URL=http://127.0.0.1:3001  # lida em tempo de execução pelo proxy /api
